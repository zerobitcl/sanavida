ErrorDocument 404 /404.html
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS: en Hostinger el SSL del dominio temporal suele estar activo.
  # Si ves error de certificado al entrar, comenta las 2 líneas siguientes.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Quitar www (cuando tengas dominio propio). En *.hostingersite.com no hace nada.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # API cotización (Hostinger PHP) — mismo path que en local con Node.
  RewriteRule ^api/cotizacion/?$ api/cotizacion.php [L,QSA]

  # Una sola URL por página (con "/" final) → mejor SEO, sin duplicados.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

# No servir la config con la API key.
<Files "config.local.php">
  Require all denied
</Files>
<Files "config.example.php">
  Require all denied
</Files>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
